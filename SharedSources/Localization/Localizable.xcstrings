{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Day 1 → Day 40\" — how long you've kept going." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Hari 1 → Hari 40\" — sudah berapa lama kamu konsisten."
          }
        }
      }
    },
