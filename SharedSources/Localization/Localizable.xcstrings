    "%@: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        }
      }
    },
    "%@: a retinoid and an exfoliating acid together can be a lot for skin. Many people use them on different nights." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: retinoid dan asam eksfoliasi bersamaan bisa terlalu berat untuk kulit. Banyak orang memakainya di malam yang berbeda."
          }
        }
      }
    },
    "%@: acids and retinoids make skin more sensitive to sun. Add a sunscreen to this morning routine." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: asam dan retinoid membuat kulit lebih sensitif terhadap matahari. Tambahkan sunscreen ke rutinitas pagi ini."
          }
        }
      }
    },
    "%@: all thirty days done. That's a real habit now." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tiga puluh hari selesai. Sekarang itu sudah jadi kebiasaan."
          }
        }
      }
    },
    "%@: benzoyl peroxide can make some retinoids less effective and adds dryness. Try them at different times." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: benzoyl peroxide bisa membuat sebagian retinoid kurang efektif dan menambah kering. Coba pakai di waktu berbeda."
          }
        }
      }
    },
    "%@: day %lld of %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: day %2$lld of %3$lld"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: hari %lld dari %lld"
          }
        }
      }
    },
    "%@: retinoids are usually an evening step, since sunlight breaks some of them down." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: retinoid biasanya dipakai malam hari, karena sinar matahari bisa menguraikan sebagiannya."
          }
        }
      }
    },
    "%@: two exfoliating products in one routine can over-exfoliate. One is usually enough." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: dua produk eksfoliasi dalam satu rutinitas bisa berlebihan. Biasanya satu sudah cukup."
          }
        }
      }
    },
    "%@: vitamin C with acids or benzoyl peroxide can sting. Try vitamin C in the morning and the others at night." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: vitamin C dengan asam atau benzoyl peroxide bisa terasa perih. Coba vitamin C di pagi hari dan yang lain di malam hari."
          }
        }
      }
    },
