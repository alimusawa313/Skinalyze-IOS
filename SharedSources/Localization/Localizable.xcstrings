        }
      }
    },
    "A one-minute scan, private to your phone. Track breakouts by face zone and see which products actually help." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai satu menit, tersimpan pribadi di ponselmu. Pantau jerawat per area wajah dan lihat produk mana yang benar-benar membantu."
